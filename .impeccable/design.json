  "narrative": {
    "northStar": "Apple/macOS System Settings",
    "overview": "参考用户提供的浅蓝灰 Cockpit 截图，保持安静、清楚、有秩序的设置界面。浅灰侧栏承担位置感，近白底面承托白色分组，蓝色提示可执行操作与键盘焦点。此方向由用户明确指定，不另造品牌隐喻，也不把熟悉的原生工具改成营销页面。\n\n实现使用 Windows WPF，保留 Windows 标题栏、窗口按钮、文件选择器和键盘约定。中文使用系统字体，实测 IP 通过更大的数字字体成为阅读重点；操作反馈紧邻当前任务，未知状态以文字说明。",
    "keyCharacteristics": [
      "浅灰侧栏、白色内嵌选中项、分组设置内容。",
      "克制蓝色操作、独立文字状态、无装饰性阴影。",
      "原生 DIP 尺寸与清晰中文，随 Windows DPI 缩放。",
      "单次短淡入，遵守 Windows 客户区动画设置。"
    ],
    "rules": [
      {
        "name": "The Status Text Rule",
        "body": "结果必须保留文字含义；蓝色检查中、绿色符合预期、红色失败不能代替可读结论。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 延续用户确认的 Apple/macOS System Settings 审美，同时保留 Windows 原生窗口与键盘习惯。",
      "**Do** 使用 DIP 记录原生尺寸，并区分窗口外尺寸、客户区和截图设备像素。",
      "**Do** 复用已有白色分组、灰色辅助文字、蓝色操作和显式状态文案。",
      "**Do** 保留独立焦点叠层与系统动画偏好检查。"
    ],
    "donts": [
      "**Don't** 添加仿 macOS 红黄绿窗口按钮、玻璃装饰、位图装饰或私有字体。",
      "**Don't** 把悬停改为整控件透明度变化，或让焦点环引起布局移动。",
      "**Don't** 用颜色取代状态文字，或把未知观测写成确定成功。",
      "**Don't** 将面板用 HTML/CSS 预览、合成色阶或未实现的响应式规则写成 WPF 现状。"
    ]
  }
}
