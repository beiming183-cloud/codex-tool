<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>CodexToolbox</AssemblyName><Version>2.4.0</Version><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>App.ico</ApplicationIcon><Product>Codex 工具箱</Product><Description>自动发现 Codex 的 Windows 线路与额度工具箱</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed><DebugType>none</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
